+/* SexOS: finish every key hash with a full avalanche. The raw values below keep
+   their low bits zero for small integers (the low word of the double is zero) and
+   for heap pointers (8-byte aligned), and buckets are chosen by the low bits, so
+   Maps keyed by node ids or objects collapsed into a few long chains. */
+static inline uint32_t map_hash_mix(uint32_t h)
+{
+    h ^= h >> 16;
+    h *= 0x7feb352d;
+    h ^= h >> 15;
+    h *= 0x846ca68b;
+    h ^= h >> 16;
+    return h;
+}
