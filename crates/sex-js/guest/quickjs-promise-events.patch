+/* Host-only provenance helpers. No object property or source-name heuristic is
+   used to unmute code. Bound functions keep their target's source; proxies and
+   generated/unknown callbacks fail closed after opaque code entered the VM. */
+static bool sexos_function_muted(JSValueConst function) {
+    for (int depth = 0; depth < 16 && JS_IsObject(function); depth++) {
+        JSObject *p = JS_VALUE_GET_OBJ(function);
+        if (js_class_has_bytecode(p->class_id))
+            return p->u.func.function_bytecode->sexos_muted_errors;
+        if (p->class_id == JS_CLASS_BOUND_FUNCTION) {
+            if (p->u.bound_function->sexos_muted_errors) return true;
+            function = p->u.bound_function->func_obj;
+            continue;
+        }
+        if (p->class_id == JS_CLASS_C_FUNCTION_DATA)
+            return p->u.c_function_data_record->sexos_muted_errors;
+        return p->class_id == JS_CLASS_PROXY && sexos_opaque_source_seen;
+    }
+    return JS_IsObject(function) && sexos_opaque_source_seen;
+}
+static JSFunctionBytecode *sexos_running_bytecode(JSContext *ctx) {
+    for (JSStackFrame *f = ctx->rt->current_stack_frame; f; f = f->prev_frame) {
+        if (JS_IsObject(f->cur_func)) {
+            JSObject *p = JS_VALUE_GET_OBJ(f->cur_func);
+            if (js_class_has_bytecode(p->class_id)) return p->u.func.function_bytecode;
+        }
+    }
+    return NULL;
+}
+static bool sexos_running_muted(JSContext *ctx) {
+    if (sexos_job_muted > 0) return true;
+    JSFunctionBytecode *b = sexos_running_bytecode(ctx);
+    if (b) return b->sexos_muted_errors;
+    if (sexos_job_muted == 0) return false;
+    return sexos_compile_origin >= 0 ? sexos_compile_origin == 1 : sexos_opaque_source_seen;
+}
+static bool sexos_compiled_muted(JSContext *ctx) {
+    JSFunctionBytecode *b = sexos_running_bytecode(ctx);
+    /* eval/Function and reentrant compilations lack an independent fetch policy. */
+    if (b) return b->sexos_muted_errors || sexos_opaque_source_seen;
+    return sexos_compile_origin != 0;
+}
+static void sexos_promise_inherit(JSValueConst promise, JSValueConst source) {
+    JSPromiseData *p = JS_GetOpaque(promise, JS_CLASS_PROMISE);
+    if (!p) return;
+    JSPromiseData *other = JS_GetOpaque(source, JS_CLASS_PROMISE);
+    p->sexos_muted_errors |= other ? other->sexos_muted_errors : sexos_function_muted(source);
+}
+static bool sexos_promise_muted(JSValueConst promise) {
+    JSPromiseData *p = JS_GetOpaque(promise, JS_CLASS_PROMISE);
+    return p && p->sexos_muted_errors;
+}
+static void sexos_promise_mark_muted(JSValueConst promise) {
+    JSPromiseData *p = JS_GetOpaque(promise, JS_CLASS_PROMISE);
+    if (p) p->sexos_muted_errors = true;
+}
+/* Inspect plain descriptors without invoking getters, proxy traps or exotic
+   lookups a second time. Ambiguous lookups fail closed after opaque code. */
+static bool sexos_property_getter_muted(JSValueConst object, JSAtom atom) {
+    JSObject *p = JS_IsObject(object) ? JS_VALUE_GET_OBJ(object) : NULL;
+    for (int depth = 0; p && depth < 32; depth++, p = p->shape->proto) {
+        if (p->is_exotic) return sexos_opaque_source_seen;
+        JSProperty *value;
+        JSShapeProperty *property = find_own_property(&value, p, atom);
+        if (!property) continue;
+        int type = property->flags & JS_PROP_TMASK;
+        if (type == JS_PROP_GETSET)
+            return value->u.getset.getter && sexos_function_muted(JS_MKPTR(JS_TAG_OBJECT, value->u.getset.getter));
+        return type != JS_PROP_NORMAL && sexos_opaque_source_seen;
+    }
+    return p && sexos_opaque_source_seen;
+}
+static bool sexos_adoption_lookup_muted(JSValueConst object) {
+    return sexos_property_getter_muted(object, JS_ATOM_then) ||
+        (JS_IsPromise(object) && sexos_property_getter_muted(object, JS_ATOM_constructor));
+}
+static void sexos_resolver_mark_muted(JSValueConst resolver) {
+    JSPromiseFunctionData *p = JS_GetOpaque(resolver, JS_CLASS_PROMISE_RESOLVE_FUNCTION);
+    if (p) sexos_promise_mark_muted(p->promise);
+}
+static void sexos_asyncgen_mark_current(JSAsyncGeneratorData *s) {
+    if (!list_empty(&s->queue)) {
+        JSAsyncGeneratorRequest *request = list_entry(s->queue.next, JSAsyncGeneratorRequest, link);
+        sexos_promise_mark_muted(request->promise);
+    }
+}
+/* Captured native intrinsics use these only for engine-owned notifications. */
+int sexos_promise_flags(JSValueConst promise) {
+    JSPromiseData *p = JS_GetOpaque(promise, JS_CLASS_PROMISE);
+    if (!p) return 3; /* not a native promise: handled and muted */
+    return (p->is_handled ? 1 : 0) | (p->sexos_muted_errors ? 2 : 0);
+}
