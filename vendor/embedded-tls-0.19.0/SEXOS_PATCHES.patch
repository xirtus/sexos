+#[cfg(test)]
+mod sexos_record_regressions {
+    use super::*;
+    use crate::{Aes128GcmSha256, record::RecordHeader};
+    use aes_gcm::Aes128Gcm;
+    use embedded_io::ErrorType;
+
+    // Both sides use the actual freshly constructed read schedule's test key
+    // and nonce. AEAD encryption is real; no decrypt mock or certificate bypass
+    // is introduced into the production path by this harness.
+    fn encrypted(plaintext: &[u8]) -> std::vec::Vec<u8> {
+        let mut schedule = KeySchedule::<Aes128GcmSha256>::new();
+        let key = schedule.read_state().get_key().unwrap().clone();
+        let nonce = schedule.read_state().get_nonce().unwrap();
+        let length = plaintext.len() + 16;
+        let header = [23, 3, 3, (length >> 8) as u8, length as u8];
+        let mut backing = [0u8; 128];
+        let mut data = CryptoBuffer::wrap_with_pos(&mut backing, 0);
+        data.extend_from_slice(plaintext).unwrap();
+        Aes128Gcm::new(&key).encrypt_in_place(&nonce, &header, &mut data).unwrap();
+        let mut wire = header.to_vec();
+        wire.extend_from_slice(data.as_slice());
+        wire
+    }
+    struct Input<'a>(&'a [u8]);
+    impl ErrorType for Input<'_> {type Error = core::convert::Infallible;}
+    impl BlockingRead for Input<'_> {
+        fn read(&mut self, out: &mut [u8]) -> Result<usize, Self::Error> {
+            let n = out.len().min(self.0.len()).min(3);
+            out[..n].copy_from_slice(&self.0[..n]);
+            self.0 = &self.0[n..];
+            Ok(n)
+        }
+    }
+    fn decode(wire: &[u8]) -> (Result<(), TlsError>, usize) {
+        let mut input = Input(wire);
+        let mut backing = [0u8; 128];
+        let mut reader = RecordReader::new(&mut backing);
+        let mut schedule = KeySchedule::<Aes128GcmSha256>::new();
+        let mut calls = 0;
+        let result = reader.read_blocking(&mut input, schedule.read_state()).and_then(|record| {
+            decrypt_record(schedule.read_state(), record, |_, _| {calls += 1; Ok(())})
+        });
+        (result, calls)
+    }
+    #[test]
+    fn authenticated_empty_inner_plaintext_is_a_record_error_not_a_panic() {
+        let (result, calls) = decode(&encrypted(&[]));
+        assert!(matches!(result, Err(TlsError::InvalidRecord)));
+        assert_eq!(calls, 0);
+    }
+    #[test]
+    fn authenticated_all_zero_padding_has_no_content_type() {
+        for length in [1, 16, 64] {
+            let (result, calls) = decode(&encrypted(&[0u8; 64][..length]));
+            assert!(matches!(result, Err(TlsError::InvalidRecord)));
+            assert_eq!(calls, 0);
+        }
+    }
+    #[test]
+    fn actual_encrypted_application_record_accepts_zero_payload_and_padding() {
+        // TLS permits empty ApplicationData. Its nonzero inner content type is
+        // distinct from an absent type, including after stripping zero padding.
+        for plaintext in [&[23u8][..], &[23, 0, 0][..], &[7, 8, 23, 0][..]] {
+            let (result, calls) = decode(&encrypted(plaintext));
+            assert!(result.is_ok());
+            assert_eq!(calls, 1);
+        }
+    }
+    #[test]
+    fn actual_record_reader_rejects_each_truncated_header_ciphertext_and_tag() {
+        let wire = encrypted(&[23, 0, 0]);
+        for end in 0..wire.len() {
+            let (result, calls) = decode(&wire[..end]);
+            assert!(matches!(result, Err(TlsError::IoError)), "prefix {end}");
+            assert_eq!(calls, 0);
+        }
+    }
+    #[test]
+    fn ciphertext_corruption_and_missing_aead_tag_never_reach_callback() {
+        let mut wire = encrypted(&[23]);
+        let last = wire.len() - 1;
+        wire[last] ^= 1;
+        assert!(matches!(decode(&wire), (Err(TlsError::CryptoError), 0)));
+        // A complete record with a short encrypted body reaches AEAD's actual
+        // tag-length check, rather than only the transport's EOF check.
+        for length in 0..16 {
+            let mut short = [0u8; 21];
+            short[..5].copy_from_slice(RecordHeader::decode([23, 3, 3, 0, length]).unwrap().data());
+            assert!(matches!(decode(&short[..5 + length as usize]), (Err(TlsError::CryptoError), 0)));
+        }
+    }
+}
