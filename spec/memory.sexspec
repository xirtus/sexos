    {
      "id": "PAGING_FAULT_RECOVERY",
      "requirement": "Only a boot-authorized pager can bind a selected unused frame to the exact pending task/page and resume its saved instruction after commit; duplicates cannot remap or wake twice.",
      "status": "partial",
      "sources": [
