    }
  ],
  "transitions": [
    {
      "event": "PAGE_FAULT",
      "preconditions": [
        "Faulting domain exact; sanctioned non-self pager edge exists; request valid."
      ],
      "effects": [
        "Save complete context, establish fault custody, and forward address/error/unique token by value with authenticated caller."
      ],
      "forbidden": [
        "Borrowed stack pointer; self-route; assume enqueue means recovery."
      ],
      "checks": [
        "fault_transport",
        "fault_transactions",
        "paging_runtime"
      ]
    },
    {
      "event": "REGION_VIEW",
      "preconditions": [
        "Actual caller Region or Pci capability exists; requested rights and nonempty checked extent fit immutable boot grant."
      ],
      "effects": [
        "Return existing VA and length; disclose PA only with DMA_ADDRESS; leave mappings, allocation and capability graph unchanged."
      ],
      "forbidden": [
        "User descriptor substitutes for authority; truncated selector or rights alias; runtime frame allocation or mapping."
      ],
      "checks": [
        "memory_regions",
        "driver_regions",
        "drive_dma",
        "memory_runtime"
      ]
    },
    {
      "event": "FRAME_ACQUIRE",
      "preconditions": [
        "Sanctioned region/frame authority; valid extent and budget."
      ],
      "effects": [
        "Sext selects a free index within its immutable pool grant and policy quota, zeroes all4096 bytes and retains rollback/publication state."
      ],
      "forbidden": [
        "Ambient physical-address mapping; hidden kernel allocation policy."
      ],
      "checks": [
        "sext_pager"
      ]
    },
    {
      "event": "FRAME_COMMIT",
      "preconditions": [
        "Authenticated pending request; exact fault VA; authorized frame and permissions."
      ],
      "effects": [
        "Commit the sext-selected frame to the exact existing absent leaf through sex-pdx authorization; invalidate local TLB, retire pending token, then resume the saved task through custody protocol."
      ],
      "forbidden": [
        "Foreign completion; alias/leak on retry; kernel-only pager policy."
      ],
      "checks": [
        "fault_transactions",
        "paging_mapping",
        "paging_runtime"
      ]
    },
    {
      "event": "FRAME_RELEASE",
      "preconditions": [
        "Authenticated enrolled client and monotonic request identity; exact finalized immutable mapping/pool authority and matching live lease."
      ],
      "effects": [
        "Clear matching leaf then invalidate translation before retiring lease and releasing frame; exact retries cannot affect replacement; sext zeroes entire frame before subsequent exposure."
      ],
      "forbidden": [
        "Free before invalidation; stale request resolves new binding; uncertain completion frees or zeroes a published frame; runtime capability minting."
      ],
      "checks": [
        "paging_mapping",
        "sext_pager",
        "paging_runtime",
        "paging_reclaim_replay",
        "reply_sender"
      ]
    },
    {
      "event": "EXITED_TARGET_CLEANUP",
      "preconditions": [
        "Actual task exited with no CPU owner and released stack custody; only immutable mapping/pool grant holder may request teardown."
      ],
      "effects": [
        "Preflight all leaves and retire dead fault state, clear and invalidate every owned leaf before ledger release, permanently close range, and let sext apply successful cleanup once."
      ],
      "forbidden": [
        "Cleanup on exit intent alone; free unfinalized publication before invalidation; replay frees another client; runtime capability mint or per-process page tables."
      ],
      "checks": [
        "paging_mapping",
        "sext_pager",
        "paging_reclaim_replay",
        "paging_runtime",
        "task_exit_lifecycle",
        "task_exit_runtime"
      ]
    }
  ]
}
