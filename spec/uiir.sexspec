{
  "schema_version": 1,
  "subsystem": "uiir",
  "invariants": [
    {
      "id": "UIIR_AUTHORIZED_STREAM",
      "requirement": "UiIR is an epoch-gated data transport with sex-pdx-granted ring authority and ordered per-sender streams.",
      "status": "partial",
      "sources": [
        {
          "path": "ARCHITECTURE.md",
          "anchor": "### 1.4 UiIR"
        },
        {
          "path": "kernel/src/boot_memory.rs",
          "anchor": "pub fn init_uiir"
        }
      ],
      "checks": [
        "uiir_stream"
      ],
      "gaps": [
        "Only the first stream exists: BOOT-paired Shell ring and Display cursor regions with exact peers and one writer per page, carrying focus transitions that Display checks but does not render from. No compositor pipeline, epoch engine, replay or further streams."
      ],
      "depends_on": [
        "PDX_SOLE_AUTHORITY",
        "CAUSAL_DOMAIN_ORDER"
      ]
    },
    {
      "id": "DISPLAY_COMMIT",
      "requirement": "Frame visibility changes only at explicit commit boundaries with deterministic drop/recovery semantics.",
      "status": "partial",
      "sources": [
        {
          "path": "servers/sexdisplay/src/main.rs",
          "anchor": "fn render("
        },
        {
          "path": "crates/sex-pdx/src/display_ready.rs",
