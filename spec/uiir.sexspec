          "anchor": "pub struct"
        },
        {
          "path": "servers/sexdisplay/src/surface_groups.rs",
          "anchor": "pub struct FrameGroups"
        },
        {
          "path": "servers/silk-shell/src/linen_text_delivery.rs",
          "anchor": "pub struct Outbox"
        },
        {
          "path": "servers/silk-shell/src/launcher.rs",
          "anchor": "pub fn resolve"
        }
      ],
      "checks": [
        "display_ready",
        "display_surface_lifecycle",
        "shell_app_cleanup",
        "display_text_readability",
        "desktop_close_runtime",
        "desktop_content",
        "display_surface_groups",
        "linen_text_delivery",
        "launcher"
      ],
      "gaps": [
        "Boot readiness protocol does not prove atomic epoch frames, latch recovery or replay."
      ],
      "depends_on": [
